<?xml version="1.0" encoding="utf-8"?>
<!--
  SignPath artifact configuration "windows-installer": the Inno Setup
  installer, built from the signed executable. The GitHub artifact is a zip
  holding the installer only.
  ${version}: the app's version as in pubspec.yaml (0.32.0+64);
  ${appVersion}: the same without the build number (0.32.0), as in the
  installer's name. Both given by the workflow.
-->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <zip-file>
    <pe-file path="FamilyScreenTime-${appVersion}-windows-setup.exe" product-name="Family Screen Time" product-version="${version}">
      <authenticode-sign/>
    </pe-file>
  </zip-file>
</artifact-configuration>
